# Example environment variables for backend (do NOT commit real secrets)
# Copy this file to `.env` and replace demo values with real credentials

# Database
MONGODB_URI=mongodb://localhost:27017/yuvakmandal

# JWT
JWT_SECRET=generate_a_long_random_value_with_crypto_randomBytes_64_hex
# Comma-separated frontend origins allowed by CORS (required in production)
ALLOWED_ORIGINS=http://localhost:5173

# Server
PORT=5000
NODE_ENV=development

# SMTP (Nodemailer) - replace with real SMTP provider settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="devbalatikayuvakmandalburahan@gmail.com"
SMTP_PASS="cmlp pwhz rwze ncjp"
SMTP_FROM="devbalatikayuvakmandalburahan@gmail.com"

# Twilio (for WhatsApp) - use sandbox credentials for testing
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+1415XXXXXXX

# Enable WhatsApp notifications (set to 'true' to enable)
ENABLE_WHATSAPP=true

# Which provider to use for WhatsApp: 'twilio' (default) or 'meta' (WhatsApp Cloud API)
# Set to 'meta' to use Meta's WhatsApp Cloud API instead of Twilio.
